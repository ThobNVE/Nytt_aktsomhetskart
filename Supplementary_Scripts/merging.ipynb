import glob
import os
import rasterio
from rasterio.merge import merge

FOLDER = r"\\nve.no\fil\sv\5 - SVFS\3 - Flom\Flomsone prosjekter\Møre og Romsdal\Fjord\Sylte\2026\DTM\Sunnmøre nord 10pkt 2024\data\dtm"   # change to your folder
tif_files = [f for f in glob.glob(os.path.join(FOLDER, "*.tif"))
             if os.path.basename(f) != "merged_sylte.tif"]

print(f"Found {len(tif_files)} .tif files to merge.")
srcs = [rasterio.open(fp) for fp in tif_files]
mosaic, out_transform = merge(srcs)
out_meta = srcs[0].meta.copy()
out_meta.update({
    "height": mosaic.shape[1],
    "width":  mosaic.shape[2],
    "transform": out_transform,
})
for s in srcs:
    s.close()
